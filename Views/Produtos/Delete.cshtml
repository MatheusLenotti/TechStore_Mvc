@model TechStoreMVC.Models.Produto

@{
    ViewData["Title"] = "Excluir produto";
}

<h1>Excluir produto</h1>

<div class="alert alert-warning">
    Tem certeza de que deseja excluir
    este produto?
</div>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">Preço</dt>
    <dd class="col-sm-10">
        @Model.Preco.ToString("C")
    </dd>

    <dt class="col-sm-2">Estoque</dt>
    <dd class="col-sm-10">@Model.Estoque</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit"
            class="btn btn-danger">
        Confirmar exclusão
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>
</form>