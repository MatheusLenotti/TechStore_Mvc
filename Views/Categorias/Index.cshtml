@model List<TechStoreMVC.Models.Categoria>

<h1>Categorias</h1>
<a asp-action="Create" class="btn btn-success">
        Nova Categoria
    </a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Situação</th>
        </tr>
    </thead>
    <tbody>
        @foreach (TechStoreMVC.Models.Categoria categoria in Model)
        {
            <tr>
                <td>@categoria.Id</td>
                <td>@categoria.Nome</td>
                <td>@categoria.Descricao</td>
                <td>@(categoria.Ativa ? "Ativa" : "Inativa")</td>
            
            <td>
                        <a asp-action="Details" asp-route-id="@categoria.Id" class="btn btn-primary btn-sm">
                            Detalhes
                        </a>

                        <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-danger btn-sm">
                            Excluir
                        </a>
                    </td>
            
            </tr>
        }
    </tbody>
</table>
